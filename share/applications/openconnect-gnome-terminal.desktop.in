[Desktop Entry]
Name=VPN Terminal
Comment=Open a terminal using the VPN profile
Exec=@TERMINAL_COMMAND@
Icon=utilities-terminal
Terminal=@NEEDS_TERMINAL@
Type=Application
Categories=System;TerminalEmulator;
# Launched by the tray, not meant to clutter the app grid. NoDisplay only hides
# it from menus; Gio.DesktopAppInfo still resolves and launches it.
NoDisplay=true
