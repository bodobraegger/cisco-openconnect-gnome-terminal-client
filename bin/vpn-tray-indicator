#!/usr/bin/env python3
"""Shows VPN tunnel state in the GNOME top bar for as long as the tunnel exists.

The session starts the indicator on connect and it stays for the life of the
session. A dropped tunnel leaves it in place offering Reconnect. Quit stops the
tunnel, closes the session window with it, and exits.
"""

from __future__ import annotations

import os
import pathlib
import signal
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("AppIndicator3", "0.1")

from gi.repository import AppIndicator3, GLib, Gio, Gtk  # noqa: E402

from openconnect_gnome.presentation import (  # noqa: E402
    DISCONNECT_LABEL,
    FALLBACK_ICON,
    QUIT_LABEL,
    RECONNECT_LABEL,
    action_labels,
    choose_icon,
    status_labels,
)
from openconnect_gnome.status import read_tunnel_status  # noqa: E402

INDICATOR_ID = "openconnect-gnome-tray"
POLL_INTERVAL_SECONDS = 3
LAUNCHER_DESKTOP_ID = "openconnect-gnome.desktop"
SESSION_COMMAND_NAME = "openconnect-session"
STOP_TUNNEL_COMMAND = ("pkexec", "pkill", "-x", "openconnect")
NOTIFY_COMMAND = ("notify-send", "--app-name=VPN")

# After acting on the tunnel the state changes within a second or two, so the
# menu is refreshed faster than the idle poll for a short window rather than
# leaving a stale "Connected" sitting there.
SETTLE_INTERVAL_SECONDS = 1
SETTLE_REFRESHES = 8

# How long Quit waits for the tunnel to drop before giving up, most likely
# because the pkexec prompt was dismissed.
QUIT_WAIT_SECONDS = 15


class VpnTrayIndicator:
    def __init__(self) -> None:
        self.indicator = AppIndicator3.Indicator.new(
            INDICATOR_ID,
            FALLBACK_ICON,
            AppIndicator3.IndicatorCategory.SYSTEM_SERVICES,
        )
        self.indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.menu = Gtk.Menu()
        self.indicator.set_menu(self.menu)
        self.handlers = {
            DISCONNECT_LABEL: self.on_disconnect,
            RECONNECT_LABEL: self.on_reconnect,
            QUIT_LABEL: self.on_quit,
        }
        self.settle_ticks_remaining = 0
        self.quit_ticks_remaining = 0
        self.refresh()
        GLib.timeout_add_seconds(POLL_INTERVAL_SECONDS, self.on_tick)

    @staticmethod
    def icon_exists(name: str) -> bool:
        return Gtk.IconTheme.get_default().has_icon(name)

    def on_tick(self) -> bool:
        self.refresh()
        return GLib.SOURCE_CONTINUE

    def on_settle_tick(self) -> bool:
        self.refresh()
        self.settle_ticks_remaining -= 1
        if self.settle_ticks_remaining > 0:
            return GLib.SOURCE_CONTINUE
        return GLib.SOURCE_REMOVE

    def start_settling(self) -> None:
        already_settling = self.settle_ticks_remaining > 0
        self.settle_ticks_remaining = SETTLE_REFRESHES
        if not already_settling:
            GLib.timeout_add_seconds(SETTLE_INTERVAL_SECONDS, self.on_settle_tick)

    def refresh(self):
        status = read_tunnel_status()
        summary = status.summary()
        self.indicator.set_icon_full(choose_icon(status, self.icon_exists), summary)
        self.indicator.set_title(summary)
        self.rebuild_menu(status)
        return status

    def rebuild_menu(self, status) -> None:
        for child in self.menu.get_children():
            self.menu.remove(child)

        for label in status_labels(status):
            item = Gtk.MenuItem(label=label)
            item.set_sensitive(False)
            self.menu.append(item)

        self.menu.append(Gtk.SeparatorMenuItem())

        for label in action_labels(status):
            item = Gtk.MenuItem(label=label)
            item.connect("activate", self.handlers[label])
            self.menu.append(item)

        self.menu.show_all()

    @staticmethod
    def notify(summary: str, body: str = "") -> None:
        try:
            subprocess.Popen([*NOTIFY_COMMAND, summary, body])
        except OSError:
            print(f"{summary}: {body}", file=sys.stderr)

    def stop_tunnel(self) -> bool:
        """Ask for the tunnel to stop. The guardian withdraws the IPv6 blackhole
        once the openconnect process is gone, so this still ends with the network
        restored."""
        try:
            subprocess.Popen(STOP_TUNNEL_COMMAND)
        except OSError as error:
            self.notify("Cannot stop VPN", str(error))
            return False
        return True

    @staticmethod
    def close_session_windows() -> None:
        """Ending the session script closes the terminal it runs in, because the
        terminal was launched to run exactly that command. Addressed by pid from
        a path match rather than `pkill -f`, which would also match any shell
        whose command line merely mentions the session."""
        try:
            found = subprocess.run(
                ("pgrep", "-f", SESSION_COMMAND_NAME),
                capture_output=True, text=True, check=False, timeout=5,
            ).stdout
        except (OSError, subprocess.TimeoutExpired):
            return

        own_pid = os.getpid()
        for line in found.split():
            pid = int(line)
            if pid == own_pid:
                continue
            try:
                os.kill(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass

    def on_disconnect(self, _item) -> None:
        if self.stop_tunnel():
            self.start_settling()

    def on_reconnect(self, _item) -> None:
        # Reconnecting needs the password and 2FA, so it goes through the same
        # terminal launcher as the first connection rather than guessing.
        launcher = Gio.DesktopAppInfo.new(LAUNCHER_DESKTOP_ID)
        if launcher is None:
            self.notify(
                "Cannot reconnect",
                f"{LAUNCHER_DESKTOP_ID} is not installed. Run install.sh.",
            )
            return
        try:
            launcher.launch(None, None)
        except GLib.Error as error:
            self.notify("Cannot reconnect", error.message)
            return
        self.start_settling()

    def on_quit(self, _item) -> None:
        if not read_tunnel_status().process_running:
            self.close_session_windows()
            Gtk.main_quit()
            return
        if not self.stop_tunnel():
            return
        self.quit_ticks_remaining = QUIT_WAIT_SECONDS
        GLib.timeout_add_seconds(1, self.on_quit_tick)

    def on_quit_tick(self) -> bool:
        # Exiting before the tunnel is really gone would hide a live VPN, so a
        # dismissed authentication prompt keeps the indicator open instead.
        if not self.refresh().process_running:
            self.close_session_windows()
            Gtk.main_quit()
            return GLib.SOURCE_REMOVE

        self.quit_ticks_remaining -= 1
        if self.quit_ticks_remaining > 0:
            return GLib.SOURCE_CONTINUE

        self.notify("VPN still running", "Indicator kept open so it stays visible.")
        return GLib.SOURCE_REMOVE


def main() -> int:
    VpnTrayIndicator()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
