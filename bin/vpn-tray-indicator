#!/usr/bin/env python3
"""Shows VPN tunnel state in the GNOME top bar and is the only control surface.

Every menu action acts on the VPN itself. There is deliberately no action that
quits the indicator alone: a tunnel running with no window and no tray icon is
invisible, which is exactly the state this tray exists to prevent.
"""

from __future__ import annotations

import pathlib
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("AppIndicator3", "0.1")

from gi.repository import AppIndicator3, GLib, Gio, Gtk  # noqa: E402

from openconnect_gnome.presentation import (  # noqa: E402
    CONNECT_LABEL,
    FALLBACK_ICON,
    QUIT_VPN_LABEL,
    action_labels,
    choose_icon,
    status_labels,
)
from openconnect_gnome.status import read_tunnel_status  # noqa: E402

INDICATOR_ID = "openconnect-gnome-tray"
POLL_INTERVAL_SECONDS = 3
LAUNCHER_DESKTOP_ID = "openconnect-gnome.desktop"
QUIT_VPN_COMMAND = ("pkexec", "pkill", "-x", "openconnect")
NOTIFY_COMMAND = ("notify-send", "--app-name=VPN")

# After acting on the tunnel the state changes within a second or two, so the
# menu is refreshed faster than the idle poll for a short window rather than
# leaving a stale "Connected" sitting there.
SETTLE_INTERVAL_SECONDS = 1
SETTLE_REFRESHES = 8


class VpnTrayIndicator:
    def __init__(self) -> None:
        self.indicator = AppIndicator3.Indicator.new(
            INDICATOR_ID,
            FALLBACK_ICON,
            AppIndicator3.IndicatorCategory.SYSTEM_SERVICES,
        )
        self.indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.menu = Gtk.Menu()
        self.indicator.set_menu(self.menu)
        self.handlers = {
            CONNECT_LABEL: self.on_connect,
            QUIT_VPN_LABEL: self.on_quit_vpn,
        }
        self.settle_ticks_remaining = 0
        self.refresh()
        GLib.timeout_add_seconds(POLL_INTERVAL_SECONDS, self.on_tick)

    @staticmethod
    def icon_exists(name: str) -> bool:
        return Gtk.IconTheme.get_default().has_icon(name)

    def on_tick(self) -> bool:
        self.refresh()
        return GLib.SOURCE_CONTINUE

    def on_settle_tick(self) -> bool:
        self.refresh()
        self.settle_ticks_remaining -= 1
        if self.settle_ticks_remaining > 0:
            return GLib.SOURCE_CONTINUE
        return GLib.SOURCE_REMOVE

    def start_settling(self) -> None:
        already_settling = self.settle_ticks_remaining > 0
        self.settle_ticks_remaining = SETTLE_REFRESHES
        if not already_settling:
            GLib.timeout_add_seconds(SETTLE_INTERVAL_SECONDS, self.on_settle_tick)

    def refresh(self) -> None:
        status = read_tunnel_status()
        summary = status.summary()
        self.indicator.set_icon_full(choose_icon(status, self.icon_exists), summary)
        self.indicator.set_title(summary)
        self.rebuild_menu(status)

    def rebuild_menu(self, status) -> None:
        for child in self.menu.get_children():
            self.menu.remove(child)

        for label in status_labels(status):
            item = Gtk.MenuItem(label=label)
            item.set_sensitive(False)
            self.menu.append(item)

        self.menu.append(Gtk.SeparatorMenuItem())

        for label in action_labels(status):
            item = Gtk.MenuItem(label=label)
            item.connect("activate", self.handlers[label])
            self.menu.append(item)

        self.menu.show_all()

    @staticmethod
    def notify(summary: str, body: str = "") -> None:
        try:
            subprocess.Popen([*NOTIFY_COMMAND, summary, body])
        except OSError:
            print(f"{summary}: {body}", file=sys.stderr)

    def on_connect(self, _item) -> None:
        # Launching the .desktop entry rather than a hard-coded terminal command
        # keeps the launcher definition in exactly one place.
        launcher = Gio.DesktopAppInfo.new(LAUNCHER_DESKTOP_ID)
        if launcher is None:
            self.notify(
                "Cannot start VPN",
                f"{LAUNCHER_DESKTOP_ID} is not installed. Run install.sh.",
            )
            return
        try:
            launcher.launch(None, None)
        except GLib.Error as error:
            self.notify("Cannot start VPN", error.message)
            return
        self.start_settling()

    def on_quit_vpn(self, _item) -> None:
        try:
            subprocess.Popen(QUIT_VPN_COMMAND)
        except OSError as error:
            self.notify("Cannot stop VPN", str(error))
            return
        # The session script's guardian withdraws the IPv6 blackhole once the
        # openconnect process is gone, so stopping from here still ends with the
        # network restored.
        self.start_settling()


def main() -> int:
    VpnTrayIndicator()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
