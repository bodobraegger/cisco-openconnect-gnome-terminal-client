#!/bin/bash
# Runs an openconnect VPN session and withdraws all touched global state on exit.
set -uo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/openconnect-gnome"
readonly CONFIG_FILE="$CONFIG_DIR/config"
readonly REQUIRED_SETTINGS=(VPN_USER VPN_GATEWAY VPN_AUTHGROUP)
readonly STALE_SESSION_GRACE_SECONDS=5
readonly IPV6_BLACKHOLE_METRIC=1
readonly OPENCONNECT_PIDFILE='/run/openconnect-gnome.pid'
readonly TRAY_COMMAND_NAME='vpn-tray-indicator'
# Root-owned, argument-free, generated from this config by `install.sh helpers`.
# When a NOPASSWD sudoers rule grants them, connecting and disconnecting never
# prompt. Without them the script falls back to plain sudo, which does prompt.
readonly PRIVILEGED_START_HELPER='/usr/local/sbin/vpn-start'
readonly PRIVILEGED_STOP_HELPER='/usr/local/sbin/vpn-stop'
readonly EXIT_CONFIG_MISSING=2 EXIT_CONFIG_INCOMPLETE=3 EXIT_NO_PRIVILEGES=4

load_configuration() {
    if [[ ! -r $CONFIG_FILE ]]; then
        echo "No configuration at $CONFIG_FILE" >&2
        echo "Copy config.example there and edit it." >&2
        return $EXIT_CONFIG_MISSING
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
    local setting missing=()
    for setting in "${REQUIRED_SETTINGS[@]}"; do
        [[ -n ${!setting:-} ]] || missing+=("$setting")
    done
    if (( ${#missing[@]} > 0 )); then
        echo "Configuration is missing: ${missing[*]}" >&2
        return $EXIT_CONFIG_INCOMPLETE
    fi
    : "${BLACKHOLE_IPV6:=yes}"
    : "${RUN_IN_BACKGROUND:=yes}"
}

# Tied to the tunnel rather than started at login, so no icon shows without a VPN.
start_tray_indicator() {
    local tray_path
    tray_path="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/$TRAY_COMMAND_NAME"
    [[ -x $tray_path ]] || return 0
    pgrep -f "$tray_path" >/dev/null 2>&1 && return 0
    setsid --fork "$tray_path" >/dev/null 2>&1
    echo "Tray indicator started"
}

terminate_stale_sessions() {
    local stale_pids
    stale_pids=$(pgrep -x openconnect) || return 0
    echo "Terminating stale openconnect session(s): ${stale_pids//$'\n'/ }"
    sudo kill $stale_pids 2>/dev/null
    local waited=0
    while (( waited < STALE_SESSION_GRACE_SECONDS )) && pgrep -x openconnect >/dev/null; do
        sleep 1
        (( waited++ ))
    done
    if pgrep -x openconnect >/dev/null; then
        echo "Stale session ignored SIGTERM, forcing termination"
        sudo pkill -KILL -x openconnect 2>/dev/null
        sleep 1
    fi
}

restore_system_state() {
    trap - EXIT INT TERM HUP QUIT
    [[ $BLACKHOLE_IPV6 == yes ]] || return 0
    # Background mode leaves openconnect running past this exit; the tray removes
    # the route when it stops the tunnel, and a crash is caught by reconciliation.
    pgrep -x openconnect >/dev/null 2>&1 && return 0
    if [[ -x $PRIVILEGED_STOP_HELPER ]]; then
        sudo -n "$PRIVILEGED_STOP_HELPER" 2>/dev/null
    else
        sudo ip -6 route del unreachable default metric "$IPV6_BLACKHOLE_METRIC" 2>/dev/null
    fi
    echo "IPv6 default route restored"
}

main() {
    load_configuration || return $?

    local openconnect_status
    if [[ -x $PRIVILEGED_START_HELPER ]]; then
        # The helper already does stale-session cleanup and the blackhole, so
        # none of the steps below are needed and nothing has to prompt.
        trap restore_system_state EXIT INT TERM HUP QUIT
        sudo -n "$PRIVILEGED_START_HELPER"
        openconnect_status=$?
    else
        sudo -v || { echo "Could not obtain sudo privileges, aborting" >&2; return $EXIT_NO_PRIVILEGES; }
        terminate_stale_sessions
        if [[ $BLACKHOLE_IPV6 == yes ]] && ip -6 route show default | grep -q "unreachable .*metric $IPV6_BLACKHOLE_METRIC"; then
            echo "Removing IPv6 blackhole left by a previous run"
            sudo ip -6 route del unreachable default metric "$IPV6_BLACKHOLE_METRIC" 2>/dev/null
        fi

        trap restore_system_state EXIT INT TERM HUP QUIT
        if [[ $BLACKHOLE_IPV6 == yes ]]; then
            sudo ip -6 route replace unreachable default metric "$IPV6_BLACKHOLE_METRIC"
            echo "IPv6 blackholed for the duration of the VPN session"
        fi
        local -a background_options=()
        [[ $RUN_IN_BACKGROUND == yes ]] && background_options=(--background --pid-file "$OPENCONNECT_PIDFILE")
        sudo openconnect \
            -u "$VPN_USER" \
            --useragent=AnyConnect \
            -g "$VPN_AUTHGROUP" \
            --no-external-auth \
            "${background_options[@]}" \
            "$VPN_GATEWAY"
        openconnect_status=$?
    fi

    (( openconnect_status == 0 )) && pgrep -x openconnect >/dev/null 2>&1 && start_tray_indicator
    restore_system_state
    return $openconnect_status
}

main
session_status=$?
if (( session_status == 0 )) && pgrep -x openconnect >/dev/null 2>&1; then
    echo "Connected. This window can be closed; the tray keeps the session."
    exit 0
fi
echo "openconnect exited with status $session_status"
[[ -t 0 ]] && read -r -p "Press Enter to close this window"
exit $session_status
